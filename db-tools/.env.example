# Copy this file to ".env" and fill in the values from your data team.
# .env is gitignored (the whole db-tools/ folder is) — it will NEVER be committed.

PGHOST=your-cluster.xxxxxxxx.ap-southeast-1.redshift.amazonaws.com
PGPORT=5439
PGDATABASE=your_database
PGUSER=your_user
PGPASSWORD=your_password

# Redshift almost always requires SSL. Leave as "require" unless told otherwise.
PGSSL=require
