rules_version = '2';

// =====================================================================
// Firestore rules for the Fairdee data project: fairdee-monthly-metr
// (this is the project in public/firebase-config.js — NOT fairdee-okr)
//
// Deploy with:
//   firebase deploy --only firestore:rules --project fairdee-monthly-metr
// or paste into Firebase Console → Firestore Database → Rules.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in @fairdee.co.th account
    function isFairdee() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@fairdee[.]co[.]th$');
    }

    // Hub admins — can manage the Central Hub cards & folders
    function isHubAdmin() {
      return isFairdee() && request.auth.token.email in [
        'thanat.s@fairdee.co.th',
        'nichakan@fairdee.co.th'
      ];
    }

    // ---- Central Hub cards & folders ----
    // Everyone at Fairdee sees the same cards; only admins can change them.
    match /hubItems/{itemId} {
      allow read:  if isFairdee();
      allow write: if isHubAdmin();
    }

    // ---- User profiles ----
    match /users/{uid} {
      allow read:  if isFairdee();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Monthly Metrics targets ----
    match /targets/{targetId} {
      allow read, write: if isFairdee();
    }

    // ---- OKR data snapshot (daily Redshift mirror) ----
    // Read: any signed-in @fairdee.co.th user. Write: nobody from the client —
    // only the GitHub Action's Admin SDK writes it (the Admin SDK bypasses these
    // rules), so the numbers can't be read anonymously or altered from a browser.
    match /okr_data/{docId} {
      allow read:  if isFairdee();
      allow write: if false;
    }

    // ---- Monthly Metrics sheet mirror (daily Google Sheets mirror) ----
    // Same shape as okr_data: written only by the Fairdee_MM repo's GitHub
    // Action ("Refresh Monthly Metrics data") via the Admin SDK, so the
    // spreadsheets can be unpublished and the numbers can't be read anonymously.
    // Reader: public/mm-data-store.js in the Fairdee_MM repo.
    match /mm_data/{docId} {
      allow read:  if isFairdee();
      allow write: if false;
    }
  }
}
